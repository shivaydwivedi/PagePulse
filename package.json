{
  "name": "page-pulse",
  "version": "0.1.0",
  "description": "Production-minded URL health and quality audit API foundation.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "check:hygiene": "node scripts/check-repository-hygiene.js",
    "ci": "npm run lint && npm run coverage && npm run check:hygiene"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "express": "^5.1.0",
    "ipaddr.js": "1.9.1",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "undici": "^7.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
